{
  "name": "waymark-engine",
  "version": "2.7.0",
  "description": "Sub-millisecond AST structural & lexical BM25 code intelligence for AI coding agents. Ask your codebase a question, get exact file + symbol + line span in milliseconds.",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cli": "./dist/src/cli.js"
  },
  "bin": {
    "waymark-engine": "dist/src/mcp/capnIndex.js",
    "waymark-mcp": "dist/src/mcp/capnIndex.js",
    "waymark": "dist/src/cli.js",
    "waymark-init": "bin/waymark-init.mjs",
    "waymark-ask": "bin/waymark-ask.mjs",
    "waymark-discover": "bin/waymark-discover.mjs",
    "waymark-symbols": "bin/waymark-symbols.mjs",
    "waymark-chart": "bin/waymark-chart.mjs",
    "waymark-unchart": "bin/waymark-unchart.mjs",
    "waymark-bust": "bin/waymark-bust.mjs",
    "waymark-prune": "bin/waymark-prune.mjs",
    "waymark-list": "bin/waymark-list.mjs",
    "waymark-context": "bin/waymark-context.mjs",
    "waymark-daemon": "bin/waymark-daemon.mjs",
    "waymark-repl": "bin/waymark-repl.mjs",
    "waymark-bootstrap": "bin/waymark-bootstrap.mjs",
    "waymark-map": "bin/waymark-map.mjs"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md",
    "LICENSE",
    "glama.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paragon-ux/waymark-engine.git"
  },
  "keywords": [
    "ai-agent",
    "code-discovery",
    "ast",
    "tree-sitter",
    "code-search",
    "code-intelligence",
    "symbol-search",
    "bm25",
    "fts5",
    "mcp",
    "modelcontextprotocol",
    "semantic-search",
    "llm-tools",
    "developer-tools"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"fs.copyFileSync('src/viewer.html', 'dist/src/viewer.html')\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "verify": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:prompts": "npm run build && node dist/src/cli.js repl --manifest docs/prompts/CATALOGUE_MANIFEST.jsonl",
    "test:benchmark": "node benchmarks/suites/benchmark_stateless_vs_resident.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@paragon-ux/capn-hook": "^1.1.0",
    "@paragon-ux/codedb-core": "^1.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.24.0"
  }
}
