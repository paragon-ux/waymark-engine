{
  "name": "waymark-engine",
  "version": "1.3.1",
  "description": "Agentic code discovery: ask your codebase a question, get exact file + symbol + line span in milliseconds. No re-reading, no guessing, no index to build.",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cli": "./dist/src/cli.js"
  },
  "bin": {
    "waymark": "dist/src/cli.js",
    "waymark-init": "bin/waymark-init.mjs",
    "waymark-ask": "bin/waymark-ask.mjs",
    "waymark-discover": "bin/waymark-discover.mjs",
    "waymark-chart": "bin/waymark-chart.mjs",
    "waymark-unchart": "bin/waymark-unchart.mjs",
    "waymark-bust": "bin/waymark-bust.mjs",
    "waymark-prune": "bin/waymark-prune.mjs",
    "waymark-list": "bin/waymark-list.mjs",
    "waymark-context": "bin/waymark-context.mjs",
    "waymark-mcp": "dist/src/mcp/capnIndex.js"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paragon-ux/waymark-engine.git"
  },
  "keywords": [
    "ai-agent",
    "code-discovery",
    "ast",
    "tree-sitter",
    "code-search",
    "code-intelligence",
    "symbol-search",
    "bm25",
    "fts5",
    "mcp",
    "semantic-search",
    "llm-tools",
    "developer-tools"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "verify": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@paragon-ux/capn-hook": "^1.1.0",
    "@paragon-ux/codedb-core": "^1.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.24.0"
  }
}
